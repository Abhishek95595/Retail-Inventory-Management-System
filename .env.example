# ==============================================================================
# Retail Inventory Management System (RIMS) - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development. Never commit .env.local to Git.

# Application Environment
NODE_ENV="development"
PORT=3000

# NextAuth / Application Secret (Generate using: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-secret"

# PostgreSQL Database Connection URL
# For local Homebrew PostgreSQL on macOS:
# DATABASE_URL="postgresql://<username>:@localhost:5432/rims_dev"
# For Docker Compose PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/rims_dev"

# Docker Compose Database Settings (used only by docker-compose.yml)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="rims_dev"
POSTGRES_PORT=5432
